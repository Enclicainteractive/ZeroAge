NODE_ENV=production
ZEROAGE_PORT=3088
ZEROAGE_PUBLIC_ORIGIN=https://zeroage.example.org
ZEROAGE_CORS_ORIGINS=https://zeroage.example.org,https://www.example.org
ZEROAGE_TRUST_PROXY_HOPS=1
ZEROAGE_GATEWAY_SECRET=replace-with-a-long-random-secret
