AGE_ASSURANCE_ISSUER_ID=your-accredited-issuer-id
AGE_ASSURANCE_ISSUER_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-issuer-ed25519-public-key\n-----END PUBLIC KEY-----
AGE_ASSURANCE_ISSUER_AUTH_URL=
AGE_ASSURANCE_STATUS_HMAC_KEY=replace-with-a-distinct-32-byte-or-longer-random-secret
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=zeroage
MARIADB_PASSWORD=replace-me
MARIADB_DATABASE=eiapi
